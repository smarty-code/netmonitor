#!/usr/bin/env python3
"""Stand-in NetHogs binary for tests and --stream demos without capabilities."""

from __future__ import annotations

import os
import time

INTERVAL = float(os.environ.get("FAKE_NETHOGS_INTERVAL", "0.2"))
CYCLES = int(os.environ.get("FAKE_NETHOGS_CYCLES", "0"))

FRAMES = [
    [
        "Refreshing:",
        "/usr/bin/curl/4242/1000 0.50 2.00",
        "unknown TCP/0/0 0.00 0.10",
    ],
    [
        "Refreshing:",
        "/usr/bin/curl/4242/1000 0.25 1.50",
        "/usr/bin/firefox/1001/1000 0.10 0.80",
    ],
]


def main() -> int:
    count = 0
    while True:
        for line in FRAMES[count % len(FRAMES)]:
            print(line, flush=True)
        count += 1
        if CYCLES and count >= CYCLES:
            return 0
        time.sleep(INTERVAL)


if __name__ == "__main__":
    raise SystemExit(main())
